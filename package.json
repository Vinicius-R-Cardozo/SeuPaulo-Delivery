{
  "name": "seu-paulo-delivery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Seu Paulo Delivery — app de delivery do Seu Paulo Buteco (cliente, entregador e painel administrativo).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b --noEmit",
    "gen:seed": "node scripts/gen-seed.ts",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@supabase/supabase-js": "^2.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
