# Backend HTTP (FastAPI). Se definido, o app usa esta API (tem prioridade
# sobre o Supabase). Ex.: a URL pública do ngrok apontando para :8000.
VITE_API_URL=

# =========================================================================
# Seu Paulo Delivery — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o arquivo `.env` (veja .gitignore).
# =========================================================================

# Backend de dados:
#   false  -> backend mock local (localStorage). Funciona SEM nenhuma chave.
#   true   -> Supabase (produção). Exige as duas variáveis abaixo.
VITE_USE_SUPABASE=false

# Credenciais PÚBLICAS do Supabase (a anon key é protegida por RLS no banco).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# =========================================================================
# ATENÇÃO — chaves SECRETAS nunca entram aqui nem no frontend:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - tokens de gateway de pagamento (Mercado Pago / Stripe / Asaas)
# Elas vivem apenas no backend (Edge Functions / servidor), fora deste projeto.
# =========================================================================
