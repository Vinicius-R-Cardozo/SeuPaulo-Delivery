# =========================================================================
# Seu Paulo Delivery — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o arquivo `.env` (veja .gitignore).
# =========================================================================

# Credenciais públicas do Supabase em Project > Connect.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Compatibilidade com projetos que ainda usam a chave anon legada.
VITE_SUPABASE_ANON_KEY=

# URL da página web de recuperação. O app usa o site oficial por padrão.
# Para homologação, a URL também deve estar autorizada no Supabase e no template local.
VITE_DELIVERY_PASSWORD_RESET_URL=https://www.seupaulobuteco.com.br/delivery/redefinir-senha

# =========================================================================
# ATENÇÃO — chaves SECRETAS nunca entram aqui nem no frontend:
#   - sb_secret_... e SUPABASE_SERVICE_ROLE_KEY
#   - tokens de gateway de pagamento (Mercado Pago / Stripe / Asaas)
# Elas vivem apenas no backend (Edge Functions / servidor), fora deste projeto.
# =========================================================================
